{
  "name": "langmap",
  "private": true,
  "description": "世界の言語を、話されている地域の地図と一緒に見るサイト",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/fetch-boundaries.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-boundaries.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "boundaries": "node scripts/fetch-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "d3-geo": "3.1.2",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.6",
    "@types/topojson-client": "3.1.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
